{
  "entityId": "aded0afd-47f8-411e-ba99-9684571caaf8",
  "name": "Shopify Signup → New Patient",
  "description": "Sends the welcome email to a customer who just signed up in Shopify. Called by the portal's /api/webhooks/shopify/customers-create route, which verifies the Shopify signature and creates the patient record first, then posts { patientId, email, firstName, lastName, shopifyCustomerId } here.",
  "status": "draft",
  "triggers": [
    {
      "kind": "webhook",
      "name": "Shopify customer created"
    }
  ],
  "definition": {
    "version": 1,
    "steps": [
      {
        "kind": "router",
        "id": "has_email",
        "name": "Has email?",
        "executionType": "first_match",
        "branches": [
          {
            "name": "send-welcome",
            "conditions": [
              [
                {
                  "left": "{{event.payload.body.email}}",
                  "op": "truthy"
                }
              ]
            ],
            "steps": [
              {
                "kind": "send_email",
                "id": "send_welcome_email",
                "name": "Send welcome email",
                "to": "{{event.payload.body.email}}",
                "from": "info@notification.quity.com.au",
                "fromName": "Quity",
                "replyTo": "support@quity.com.au",
                "templateId": "019fce9f-d890-76cd-8a07-ff7269c0af0e",
                "variables": {
                  "patient.firstName": "{{event.payload.body.greetingName}}",
                  "patient.email": "{{event.payload.body.email}}"
                },
                "idempotencyKeySuffix": "shopify-signup-welcome"
              },
              {
                "kind": "record_activity",
                "id": "log_signup",
                "name": "Log signup on patient timeline",
                "patientId": "{{event.payload.body.patientId}}",
                "type": "patient-created",
                "entityType": "patient",
                "entityId": "{{event.payload.body.patientId}}",
                "title": "Created from Shopify signup",
                "description": "Shopify customer {{event.payload.body.shopifyCustomerId}} signed up; patient record and welcome email created automatically."
              }
            ]
          }
        ],
        "fallback": {
          "name": "no-email",
          "steps": []
        }
      }
    ]
  }
}
