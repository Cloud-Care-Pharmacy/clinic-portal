{
  "entityId": "aded0afd-47f8-411e-ba99-9684571caaf8",
  "name": "Shopify Signup → New Patient",
  "description": "Creates the patient record for a customer who just signed up in Shopify and sends them the welcome email. Called by the portal's /api/webhooks/shopify/customers-create route, which verifies the Shopify signature and skips customers who already have a record, then posts the mapped customer fields here.",
  "status": "draft",
  "triggers": [
    {
      "kind": "webhook",
      "name": "Shopify customer created"
    }
  ],
  "definition": {
    "version": 1,
    "steps": [
      {
        "kind": "router",
        "id": "has_email",
        "name": "Has email?",
        "executionType": "first_match",
        "branches": [
          {
            "name": "create-and-welcome",
            "conditions": [
              [
                {
                  "left": "{{event.payload.body.email}}",
                  "op": "truthy"
                }
              ]
            ],
            "steps": [
              {
                "kind": "patient_action",
                "id": "create_patient",
                "name": "Create patient",
                "operation": "create",
                "storeAs": "newPatient",
                "entityId": "aded0afd-47f8-411e-ba99-9684571caaf8",
                "originalEmail": "{{event.payload.body.email}}",
                "firstName": "{{event.payload.body.firstName}}",
                "lastName": "{{event.payload.body.lastName}}",
                "mobile": "{{event.payload.body.mobile}}",
                "streetAddress": "{{event.payload.body.streetAddress}}",
                "city": "{{event.payload.body.city}}",
                "state": "{{event.payload.body.state}}",
                "postcode": "{{event.payload.body.postcode}}",
                "country": "{{event.payload.body.country}}",
                "source": "shopify",
                "retry": {
                  "maxAttempts": 3,
                  "initialDelayMs": 2000,
                  "backoff": "exponential"
                }
              },
              {
                "kind": "send_email",
                "id": "send_welcome_email",
                "name": "Send welcome email",
                "to": "{{event.payload.body.email}}",
                "from": "info@notification.quity.com.au",
                "fromName": "Quity",
                "replyTo": "support@quity.com.au",
                "templateId": "019fceb6-614d-7309-be6c-d721291a8151",
                "variables": {
                  "patient.firstName": "{{event.payload.body.greetingName}}",
                  "patient.email": "{{event.payload.body.email}}"
                },
                "idempotencyKeySuffix": "shopify-signup-welcome"
              },
              {
                "kind": "record_activity",
                "id": "log_signup",
                "name": "Log signup on patient timeline",
                "patientId": "{{vars.newPatient.patientId}}",
                "type": "patient-created",
                "entityType": "patient",
                "entityId": "{{vars.newPatient.patientId}}",
                "title": "Created from Shopify signup",
                "description": "Shopify customer {{event.payload.body.shopifyCustomerId}} signed up; patient record and welcome email created automatically."
              }
            ]
          }
        ],
        "fallback": {
          "name": "no-email",
          "steps": []
        }
      }
    ]
  }
}
