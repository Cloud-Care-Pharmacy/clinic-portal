{
  "$schema": "https://www.react.doctor/react-doctor.schema.json",
  "ignore": {
    "rules": ["knip/exports", "knip/types", "react-doctor/no-giant-component"],
    "overrides": [
      {
        "files": ["src/components/ui/**"],
        "rules": [
          "knip/files",
          "jsx-a11y/label-has-associated-control",
          "jsx-a11y/heading-has-content"
        ]
      }
    ]
  }
}
