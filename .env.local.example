# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Clerk route configuration
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Backend API
NEXT_PUBLIC_API_URL=http://localhost:8787
API_SECRET=your-api-secret-here

# Shopify customers/create webhook -> POST /api/webhooks/shopify/customers-create
# Signing secret from the Shopify webhook subscription; the route rejects every
# request when it is unset. Entity is explicit here because the webhook has no
# Clerk session to resolve it from. Workflow URL is the trigger link on the
# "Shopify Signup → New Patient" workflow (Workflows -> trigger node).
SHOPIFY_WEBHOOK_SECRET=
SHOPIFY_SIGNUP_ENTITY_ID=
SHOPIFY_SIGNUP_WORKFLOW_URL=

# Parchment portal (use sandbox for local/dev environments)
NEXT_PUBLIC_PARCHMENT_PATIENT_URL_BASE=https://portal.sandbox.parchment.health/dashboard/patients

# Note: tenant/entity ID is resolved from Clerk `publicMetadata.entityId`
# (set per-user in Clerk Dashboard). There is no env-var fallback.
